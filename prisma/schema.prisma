// Prisma schema for Turso (libSQL) — stores coloring book metadata.
// File storage (PDFs, thumbnails) is handled by Vercel Blob.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "libsql"
  url       = env("TURSO_DATABASE_URL")
  directUrl = env("TURSO_DIRECT_URL")
}

model ColoringBook {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String
  pages       Int
  sizeBytes   Int
  pdfUrl      String   // Vercel Blob URL for the PDF
  thumbnailUrl String?  // Vercel Blob URL for page-1 thumbnail
  items       String   // JSON array of item names, e.g. ["Dog","Cat",...]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

// Optional: store generated covers too
model GeneratedCover {
  id          String   @id @default(cuid())
  title       String
  author      String
  pageCount   Int
  pdfUrl      String   // Vercel Blob URL
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
