# OpenAI API key — get it from https://platform.openai.com/api-keys
# Required: must have at least $1 balance for a 30-page book at medium quality.
OPENAI_API_KEY=sk-proj-your-key-here

# Optional — override defaults
# OPENAI_MODEL=gpt-image-2           # default: gpt-image-2 (fallback: gpt-image-1)
# OPENAI_QUALITY=medium              # low | medium | high  (default: medium)
# OPENAI_SIZE=1024x1024              # 1024x1024 | 1024x1536 | 1536x1024
# OUTPUT_DIR=./output               # default: ./output
