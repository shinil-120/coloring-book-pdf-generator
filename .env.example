# ─────────────────────────────────────────────────────────────────────
# Coloring Book PDF Generator — Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your actual values.
# NEVER commit `.env.local` — it's already in .gitignore.

# ── Turso (libSQL) Database ──────────────────────────────────────────
# Get these from: https://turso.tech
# After `turso db create coloring-books`:
#   turso db show coloring-books --url      → TURSO_DATABASE_URL
#   turso db tokens create coloring-books   → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://coloring-books-YOUR-HANDLE.turso.io
TURSO_DIRECT_URL=libsql://coloring-books-YOUR-HANDLE.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ── Vercel Blob (file storage) ───────────────────────────────────────
# Get this from: Vercel Dashboard → Storage → Create Blob Store
# It's auto-added to Vercel env vars when you create the store.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token-here

# ── Z.AI API Key (for AI image generation) ───────────────────────────
# Get this from: https://z.ai → API Keys
ZAI_API_KEY=your-zai-api-key-here

# ── App URL (for production) ─────────────────────────────────────────
# Set this to your Vercel deployment URL after first deploy
NEXT_PUBLIC_APP_URL=http://localhost:3000
